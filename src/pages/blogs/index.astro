---
import Layout from '../../layouts/Layout.astro';
import blogsData from '../../data/blogs-index.json';

const blogs = blogsData.blogs || [];
---

<Layout
  title="Insights & Tax Updates | M/s NRSR & Co"
  description="Tax alerts, regulatory changes, statutory audit insights, and financial advisory analyses from the Chartered Accountants at M/s NRSR & Co."
>
  <!-- Page Header Banner -->
  <section class="section-padding" style="padding-top: calc(var(--header-height) + 50px); background: linear-gradient(180deg, var(--bg-alt) 0%, var(--bg-main) 100%);">
    <div class="container text-center">
      <div class="section-header text-center" style="margin-bottom:0;">
        <span class="section-subtitle">Thought Leadership</span>
        <h1 class="section-title" style="font-size: 38px;">Insights & Publications</h1>
      </div>
      <p style="color: var(--text-muted); max-width: 700px; margin: 16px auto 0 auto; font-size: 16px;">
        Practical analyses on direct taxation, GST amendments, Companies Act compliance, and business valuation.
      </p>
    </div>
  </section>

  <!-- Blogs Grid Section -->
  <section class="section-padding">
    <div class="container">
      <div id="blogsGrid" class="content-grid content-grid-3">
        {blogs.map((b, idx) => (
          <div class="content-card card-hover reveal-on-scroll" style={`transition-delay: ${(idx % 3) * 0.1}s;`}>
            {b.image && (
              <div style="height: 180px; margin: -24px -24px 20px -24px; overflow: hidden; border-top-left-radius: 12px; border-top-right-radius: 12px;">
                <img src={b.image} alt={b.title} style="width: 100%; height: 100%; object-fit: cover;" />
              </div>
            )}
            <div class="content-card-top">
              <span class="service-badge">{b.category || 'Tax & Compliance'}</span>
              <span class="content-card-date">{b.date || '2026'}</span>
            </div>
            <h3 class="content-card-headline" style="font-size: 18px; margin: 10px 0;">
              <a href={`/blogs/${b.slug || b.id}`} style="color: inherit; text-decoration: none;">
                {b.title}
              </a>
            </h3>
            <p class="content-card-quote" style="font-style: normal; font-size: 13.5px; line-height: 1.6; color: var(--text-muted); margin-bottom: 16px;">
              {b.excerpt || b.summary}
            </p>
            <div style="margin-top: auto; padding-top: 14px; border-top: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center;">
              <span style="font-size: 12px; color: var(--text-muted);">By {b.author || 'NRSR & Co'}</span>
              <a href={`/blogs/${b.slug || b.id}`} class="btn-link" style="color: var(--color-primary); font-weight: 700; font-size: 13px;">Read Analysis →</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
