---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout
  title="About Our Firm | M/s NRSR & Co Chartered Accountants"
  description="Learn about M/s NRSR & Co: established in July 2019, peer-reviewed by the ICAI Peer Review Board, ISO certified, headquartered in Manipal with offices in Bengaluru."
>
  <!-- Page Hero Banner -->
  <section class="page-hero" style="padding-top: calc(var(--header-height) + 50px); background: linear-gradient(180deg, var(--bg-alt) 0%, var(--bg-main) 100%);">
    <div class="container text-center">
      <h1 class="section-title" style="font-size: 38px;">About Our Firm</h1>
      <p style="color: var(--text-muted); font-size: 16px; margin-top: 12px; max-width: 700px; margin-left: auto; margin-right: auto;">
        NRSR & Co is a Chartered Accountants firm providing accounting, audit, taxation, valuation, and business advisory services.
      </p>
    </div>
  </section>

  <!-- Company Overview + Credentials + Values -->
  <section class="section-padding">
    <div class="container">
      <div class="about-grid">
        <div class="about-text">
          <span class="section-subtitle">Our Firm</span>
          <h2 class="section-title">Chartered Accountants Since July 2019</h2>
          <p style="line-height: 1.7; color: var(--text-muted);">
            M/s NRSR & Co is a partnership firm of Chartered Accountants established in July 2019 in Karkala, now headquartered in Manipal, Udupi District, with a branch office in Bengaluru. The firm provides Chartered Accountant and advisory services across Karnataka and nationwide.
          </p>

          <!-- Firm Credentials & Badges -->
          <div style="display:flex; flex-wrap:wrap; gap:12px; margin:22px 0 16px 0;">
            <div style="display:flex; align-items:center; gap:10px; background:#fff; border:1.5px solid var(--color-accent); border-radius:10px; padding:10px 16px; box-shadow:0 4px 12px rgba(29,163,154,0.10);">
              <div style="color:var(--color-primary);"><Icon name="landmark" size={22} /></div>
              <div>
                <div style="font-size:10px; font-weight:700; color:var(--color-primary); letter-spacing:0.5px; text-transform:uppercase;">ICAI Member Firm</div>
                <div style="font-size:10px; color:var(--text-muted);">Established July 2019</div>
              </div>
            </div>
            <div style="display:flex; align-items:center; gap:10px; background:#fff; border:1.5px solid var(--color-accent); border-radius:10px; padding:10px 16px; box-shadow:0 4px 12px rgba(29,163,154,0.10);">
              <div style="color:var(--color-accent);"><Icon name="check-circle" size={22} /></div>
              <div>
                <div style="font-size:10px; font-weight:700; color:var(--color-primary); letter-spacing:0.5px; text-transform:uppercase;">Peer Reviewed</div>
                <div style="font-size:10px; color:var(--text-muted);">ICAI Peer Review Board</div>
              </div>
            </div>
            <div style="display:flex; align-items:center; gap:10px; background:#fff; border:1.5px solid var(--color-accent); border-radius:10px; padding:10px 16px; box-shadow:0 4px 12px rgba(29,163,154,0.10);">
              <div style="color:#d97706;"><Icon name="award" size={22} /></div>
              <div>
                <div style="font-size:10px; font-weight:700; color:var(--color-primary); letter-spacing:0.5px; text-transform:uppercase;">ISO Certified</div>
                <div style="font-size:10px; color:var(--text-muted);">Quality Management System</div>
              </div>
            </div>
          </div>

          <p style="color: var(--text-muted); margin-top: 16px; margin-bottom: 8px; font-size: 14px;">The firm's practice is guided by the following principles:</p>
          <ul style="display: flex; flex-direction: column; gap: 12px;">
            <li style="display: flex; gap: 15px; font-size: 14px; color: var(--text-muted);">
              <strong style="color: var(--color-primary);">Integrity:</strong> Clear, transparent reporting is provided to clients from the outset of an engagement.
            </li>
            <li style="display: flex; gap: 15px; font-size: 14px; color: var(--text-muted);">
              <strong style="color: var(--color-primary);">Transparency:</strong> Clients are kept updated periodically, with assessments shared before external filings.
            </li>
            <li style="display: flex; gap: 15px; font-size: 14px; color: var(--text-muted);">
              <strong style="color: var(--color-primary);">Client Centricity:</strong> Each engagement is approached with attention to the client's specific financial and compliance requirements.
            </li>
          </ul>
        </div>

        <div class="about-visual" style="display: flex; flex-direction: column; gap: 20px;">
          <div style="background-color: var(--bg-alt); border-radius: 12px; padding: 28px; border: var(--card-border);">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
              <div style="text-align: center; padding: 12px; background-color: #ffffff; border-radius: 6px;">
                <span style="font-size: 26px; font-weight: 700; color: var(--color-primary);">2019</span>
                <p style="font-size: 11.5px; color: var(--text-muted); margin-top: 4px;">Firm Founded</p>
              </div>
              <div style="text-align: center; padding: 12px; background-color: #ffffff; border-radius: 6px;">
                <span style="font-size: 26px; font-weight: 700; color: var(--color-primary);">10</span>
                <p style="font-size: 11.5px; color: var(--text-muted); margin-top: 4px;">Practice Divisions</p>
              </div>
            </div>
          </div>

          <div class="office-card" style="margin-bottom: 0;">
            <h4 style="margin-bottom: 10px;">Core Specializations</h4>
            <ul style="font-size: 13.5px; color: var(--text-muted); list-style: disc; padding-left: 20px; display: flex; flex-direction: column; gap: 8px;">
              <li>Accounting & Statutory Audits under IT Act, GST, Companies Act, and Banking Regulation Act.</li>
              <li>Direct & Indirect Tax Services, ensuring legal compliance and financial optimization.</li>
              <li>Business Valuation including DCF models, share valuation, and ESOP schemes.</li>
              <li>Litigation representation for GST and Income Tax dispute matters before appellate bodies.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Strategic Goals -->
  <section class="section-padding" style="background: var(--bg-alt);">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-subtitle">Objectives</span>
        <h2 class="section-title">Our Strategic Goals</h2>
      </div>

      <div class="content-grid content-grid-4">
        <div class="content-card reveal-on-scroll">
          <div style="color:var(--color-primary); margin-bottom:12px;"><Icon name="globe" size={28} /></div>
          <h3 class="content-card-headline" style="font-size:16px;">Analytical Focus</h3>
          <p class="content-card-quote" style="font-style:normal;">To function as an analytical, research-oriented advisory practice serving clients across Karnataka and nationwide.</p>
        </div>

        <div class="content-card reveal-on-scroll reveal-down">
          <div style="color:var(--color-primary); margin-bottom:12px;"><Icon name="shield" size={28} /></div>
          <h3 class="content-card-headline" style="font-size:16px;">Sustainable Solutions</h3>
          <p class="content-card-quote" style="font-style:normal;">To provide clients with sound financial and compliance structures built for long-term stability and resilience.</p>
        </div>

        <div class="content-card reveal-on-scroll">
          <div style="color:var(--color-primary); margin-bottom:12px;"><Icon name="scale" size={28} /></div>
          <h3 class="content-card-headline" style="font-size:16px;">Professional Integrity</h3>
          <p class="content-card-quote" style="font-style:normal;">To maintain highest accuracy and compliance standards in every filing, certification, and statutory audit.</p>
        </div>

        <div class="content-card reveal-on-scroll reveal-down">
          <div style="color:var(--color-primary); margin-bottom:12px;"><Icon name="handshake" size={28} /></div>
          <h3 class="content-card-headline" style="font-size:16px;">Client Partnerships</h3>
          <p class="content-card-quote" style="font-style:normal;">To build long-lasting advisory relationships by delivering proactive counsel before regulatory deadlines.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Hub Radial Diagram -->
  <section class="section-padding">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-subtitle">One Firm</span>
        <h2 class="section-title">Every Specialization, Under One Roof</h2>
      </div>
      <div id="servicesHub" class="services-hub">
        <!-- JS-rendered interactive radial hub -->
      </div>
    </div>
  </section>
</Layout>
