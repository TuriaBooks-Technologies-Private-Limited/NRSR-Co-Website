---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const csDir = path.join(process.cwd(), 'src/data/case_studies');
  const files = fs.readdirSync(csDir).filter(f => f.endsWith('.json'));

  return files.map(file => {
    const filePath = path.join(csDir, file);
    const content = JSON.parse(fs.readFileSync(filePath, 'utf-8'));
    const slug = file.replace('.json', '');
    return {
      params: { slug },
      props: { cs: content }
    };
  });
}

const { cs } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": cs.title,
  "description": cs.summary || cs.excerpt,
  "publisher": {
    "@type": "Organization",
    "name": "M/s NRSR & Co",
    "logo": {
      "@type": "ImageObject",
      "url": "https://nrsrcoconsultants.com/assets/logo.svg"
    }
  }
};
---

<Layout
  title={`${cs.title} | NRSR & Co Case Studies`}
  description={cs.summary || cs.excerpt}
  type="article"
  jsonLd={jsonLd}
>
  <article class="section-padding" style="padding-top: calc(var(--header-height) + 50px);">
    <div class="container" style="max-width: 860px; margin: 0 auto;">
      <div style="margin-bottom: 24px;">
        <a href="/case-studies" style="color: var(--color-primary); font-weight: 700; font-size: 13px; text-decoration: none;">← Back to All Case Studies</a>
      </div>

      <div class="section-header" style="margin-bottom: 32px;">
        <span class="section-subtitle">{cs.industry || cs.category || 'Client Engagement'}</span>
        <h1 class="section-title" style="font-size: 34px; line-height: 1.3;">{cs.title}</h1>
        <p style="font-size: 16px; color: var(--text-muted); margin-top: 10px; line-height: 1.6;">
          {cs.summary || cs.excerpt}
        </p>
      </div>

      <!-- Metrics Highlight Grid -->
      {cs.metrics && cs.metrics.length > 0 && (
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 40px;">
          {cs.metrics.map((m: any) => (
            <div style="background: var(--bg-alt); padding: 20px; border-radius: 12px; border: var(--card-border); text-align: center;">
              <div style="font-size: 24px; font-weight: 800; color: var(--color-primary);">{m.val || m.value}</div>
              <div style="font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-top: 4px;">{m.label}</div>
            </div>
          ))}
        </div>
      )}

      <!-- Challenge / Solution / Results Grid -->
      <div style="display: flex; flex-direction: column; gap: 28px;">
        {cs.challenge && (
          <div style="background: #ffffff; padding: 28px; border-radius: 14px; border: var(--card-border); box-shadow: var(--card-shadow);">
            <h3 style="font-size: 20px; color: var(--color-primary); margin-top: 0; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
              <span style="color: #ef4444;"><Icon name="alert-circle" size={20} /></span> The Challenge
            </h3>
            <p style="color: var(--text-muted); line-height: 1.8; margin: 0;">{cs.challenge}</p>
          </div>
        )}

        {cs.solution && (
          <div style="background: #ffffff; padding: 28px; border-radius: 14px; border: var(--card-border); box-shadow: var(--card-shadow);">
            <h3 style="font-size: 20px; color: var(--color-primary); margin-top: 0; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
              <span style="color: var(--color-primary);"><Icon name="lightbulb" size={20} /></span> The NRSR & Co Advisory Approach
            </h3>
            <p style="color: var(--text-muted); line-height: 1.8; margin: 0;">{cs.solution}</p>
          </div>
        )}

        {cs.results && (
          <div style="background: #ffffff; padding: 28px; border-radius: 14px; border: var(--card-border); box-shadow: var(--card-shadow);">
            <h3 style="font-size: 20px; color: var(--color-accent-dark, #15803d); margin-top: 0; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
              <span style="color: #15803d;"><Icon name="trophy" size={20} /></span> Impact & Long-Term Results
            </h3>
            <p style="color: var(--text-muted); line-height: 1.8; margin: 0;">{cs.results}</p>
          </div>
        )}

        {cs.quote && (
          <div style="background: rgba(29,163,154,0.06); padding: 24px 30px; border-left: 4px solid var(--color-primary); border-radius: 0 12px 12px 0;">
            <p style="font-style: italic; font-size: 16px; color: var(--text-main); margin: 0; line-height: 1.6;">
              "{cs.quote}"
            </p>
          </div>
        )}
      </div>

      <!-- Action Footer -->
      <div style="margin-top: 48px; padding-top: 24px; border-top: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <a href="/case-studies" class="btn btn-outline">← All Case Studies</a>
        <a href="/contact" class="btn btn-primary">Discuss Your Engagement →</a>
      </div>
    </div>
  </article>
</Layout>
