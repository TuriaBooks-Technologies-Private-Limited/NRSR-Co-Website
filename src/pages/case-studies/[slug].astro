---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { parseMarkdown } from '../../utils/markdown';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const csDir = path.join(process.cwd(), 'src/data/case_studies');
  const files = fs.readdirSync(csDir).filter(f => f.endsWith('.json'));

  return files.map(file => {
    const filePath = path.join(csDir, file);
    const content = JSON.parse(fs.readFileSync(filePath, 'utf-8'));
    const slug = file.replace('.json', '');
    return {
      params: { slug },
      props: { cs: content }
    };
  });
}

const { cs } = Astro.props;
const parsedContent = cs.content ? parseMarkdown(cs.content) : '';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": cs.title,
  "description": cs.summary || cs.excerpt || cs.metaDesc,
  "publisher": {
    "@type": "Organization",
    "name": "M/s NRSR & Co",
    "logo": {
      "@type": "ImageObject",
      "url": "https://nrsrcoconsultants.com/assets/logo.svg"
    }
  }
};
---

<Layout
  title={`${cs.title} | NRSR & Co Case Studies`}
  description={cs.summary || cs.excerpt || cs.metaDesc}
  type="article"
  jsonLd={jsonLd}
>
  <article class="section-padding" style="padding-top: calc(var(--header-height) + 50px); background: linear-gradient(180deg, var(--bg-alt) 0%, var(--bg-main) 100%);">
    <div class="container" style="max-width: 920px; margin: 0 auto;">
      <!-- Breadcrumb Navigation -->
      <div style="margin-bottom: 24px;">
        <a href="/case-studies" style="color: var(--color-primary); font-weight: 700; font-size: 13px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
          <Icon name="arrow-left" size={14} /> Back to All Case Studies
        </a>
      </div>

      <!-- Case Study Header -->
      <div class="section-header" style="margin-bottom: 32px; text-align: left;">
        <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-bottom: 12px;">
          <span class="section-subtitle" style="margin: 0;">{cs.industry || cs.category || 'Client Engagement'}</span>
          {cs.duration && (
            <span style="font-size: 11px; font-weight: 700; background: rgba(0,132,180,0.1); color: var(--color-primary); padding: 3px 10px; border-radius: 12px;">
              Duration: {cs.duration}
            </span>
          )}
          {cs.regulatoryFramework && (
            <span style="font-size: 11px; font-weight: 700; background: rgba(141,198,63,0.15); color: var(--color-accent-dark, #2e7d32); padding: 3px 10px; border-radius: 12px;">
              {cs.regulatoryFramework}
            </span>
          )}
        </div>
        <h1 class="section-title" style="font-size: clamp(28px, 3.5vw, 38px); line-height: 1.25; margin-bottom: 16px;">{cs.title}</h1>
        <p style="font-size: 17px; color: var(--text-muted); line-height: 1.7; margin: 0;">
          {cs.summary || cs.excerpt || cs.metaDesc}
        </p>
      </div>

      <!-- Key Metrics Highlight Grid -->
      {cs.metrics && cs.metrics.length > 0 && (
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 40px;">
          {cs.metrics.map((m: any) => (
            <div style="background: #ffffff; padding: 22px 18px; border-radius: 14px; border: var(--card-border); box-shadow: var(--card-shadow); text-align: center; border-top: 3px solid var(--color-primary);">
              <div style="font-size: 24px; font-weight: 800; color: var(--color-primary-dark);">{m.val || m.value}</div>
              <div style="font-size: 11.5px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-top: 6px; letter-spacing: 0.02em;">{m.label}</div>
            </div>
          ))}
        </div>
      )}

      <!-- Structured Executive Case Analysis -->
      <div style="display: flex; flex-direction: column; gap: 32px;">
        
        {/* The Client & Background */}
        {cs.background && (
          <div style="background: #ffffff; padding: 32px; border-radius: 16px; border: var(--card-border); box-shadow: var(--card-shadow);">
            <h3 style="font-size: 21px; color: var(--color-primary-dark); margin-top: 0; margin-bottom: 14px; display: flex; align-items: center; gap: 10px;">
              <span style="color: var(--color-primary);"><Icon name="building" size={22} /></span>
              Client Background & Operational Context
            </h3>
            <p style="color: var(--text-main); line-height: 1.85; margin: 0; font-size: 15.5px;">{cs.background}</p>
          </div>
        )}

        {/* The Challenge */}
        {cs.challenge && (
          <div style="background: #ffffff; padding: 32px; border-radius: 16px; border: var(--card-border); box-shadow: var(--card-shadow); border-left: 5px solid #ef4444;">
            <h3 style="font-size: 21px; color: #b91c1c; margin-top: 0; margin-bottom: 14px; display: flex; align-items: center; gap: 10px;">
              <span style="color: #ef4444;"><Icon name="alert-circle" size={22} /></span>
              The Challenge & Risk Exposure
            </h3>
            <p style="color: var(--text-main); line-height: 1.85; margin: 0; font-size: 15.5px;">{cs.challenge}</p>
          </div>
        )}

        {/* Advisory Methodology & Strategy */}
        {cs.solution && (
          <div style="background: #ffffff; padding: 32px; border-radius: 16px; border: var(--card-border); box-shadow: var(--card-shadow); border-left: 5px solid var(--color-primary);">
            <h3 style="font-size: 21px; color: var(--color-primary-dark); margin-top: 0; margin-bottom: 14px; display: flex; align-items: center; gap: 10px;">
              <span style="color: var(--color-primary);"><Icon name="lightbulb" size={22} /></span>
              The NRSR & Co Advisory Approach & Methodology
            </h3>
            <p style="color: var(--text-main); line-height: 1.85; margin: 0; font-size: 15.5px;">{cs.solution}</p>
          </div>
        )}

        {/* Phased Execution Steps */}
        {cs.executionSteps && cs.executionSteps.length > 0 && (
          <div style="background: #ffffff; padding: 32px; border-radius: 16px; border: var(--card-border); box-shadow: var(--card-shadow);">
            <h3 style="font-size: 21px; color: var(--color-primary-dark); margin-top: 0; margin-bottom: 18px; display: flex; align-items: center; gap: 10px;">
              <span style="color: var(--color-primary);"><Icon name="chart" size={22} /></span>
              Phased Implementation Framework
            </h3>
            <div style="display: flex; flex-direction: column; gap: 16px;">
              {cs.executionSteps.map((step: any, idx: number) => (
                <div style="display: flex; gap: 16px; align-items: flex-start; padding: 16px; background: var(--bg-alt); border-radius: 10px; border-left: 3px solid var(--color-primary);">
                  <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--color-primary); color: #ffffff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 14px; flex-shrink: 0;">
                    {idx + 1}
                  </div>
                  <div>
                    <h4 style="font-size: 16px; margin: 0 0 6px 0; color: var(--text-main); font-weight: 700;">{step.phase || step.title}</h4>
                    <p style="font-size: 14px; color: var(--text-muted); margin: 0; line-height: 1.6;">{step.description || step.details}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Results & Measurable Impact */}
        {cs.results && (
          <div style="background: #ffffff; padding: 32px; border-radius: 16px; border: var(--card-border); box-shadow: var(--card-shadow); border-left: 5px solid var(--color-accent-dark, #15803d);">
            <h3 style="font-size: 21px; color: #15803d; margin-top: 0; margin-bottom: 14px; display: flex; align-items: center; gap: 10px;">
              <span style="color: #15803d;"><Icon name="trophy" size={22} /></span>
              Impact, Governance & Measurable Outcomes
            </h3>
            <p style="color: var(--text-main); line-height: 1.85; margin: 0; font-size: 15.5px;">{cs.results}</p>
          </div>
        )}

        {/* Partner / Engagement Quote */}
        {cs.quote && (
          <div style="background: linear-gradient(135deg, rgba(0,132,180,0.06) 0%, rgba(141,198,63,0.08) 100%); padding: 28px 32px; border-left: 4px solid var(--color-primary); border-radius: 0 16px 16px 0;">
            <p style="font-style: italic; font-size: 16.5px; color: var(--text-main); margin: 0 0 12px 0; line-height: 1.7;">
              "{cs.quote}"
            </p>
            {cs.quoteAuthor && (
              <div style="font-size: 13px; font-weight: 700; color: var(--color-primary-dark);">
                — {cs.quoteAuthor}
              </div>
            )}
          </div>
        )}

        {/* Deep Dive Markdown Body (if provided) */}
        {parsedContent && (
          <div class="article-content" style="background: #ffffff; padding: 36px; border-radius: 16px; border: var(--card-border); box-shadow: var(--card-shadow);">
            <div set:html={parsedContent} />
          </div>
        )}
      </div>

      <!-- Action Footer -->
      <div style="margin-top: 48px; padding-top: 28px; border-top: 1px solid rgba(0,132,180,0.15); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <a href="/case-studies" class="btn btn-outline">← All Case Studies</a>
        <a href="/contact" class="btn btn-primary">Discuss Your Advisory Engagement →</a>
      </div>
    </div>
  </article>
</Layout>
