---
import Layout from '../../layouts/Layout.astro';
import csData from '../../data/case_studies-index.json';

const caseStudies = csData.case_studies || [];
---

<Layout
  title="Case Studies & Client Impact | M/s NRSR & Co"
  description="Proven outcomes across statutory audits, GCC establishment, virtual CFO advisory, and tax dispute defense delivered by M/s NRSR & Co."
>
  <!-- Page Header Banner -->
  <section class="section-padding" style="padding-top: calc(var(--header-height) + 50px); background: linear-gradient(180deg, var(--bg-alt) 0%, var(--bg-main) 100%);">
    <div class="container text-center">
      <div class="section-header text-center" style="margin-bottom:0;">
        <span class="section-subtitle">Client Success Stories</span>
        <h1 class="section-title" style="font-size: 38px;">Case Studies</h1>
      </div>
      <p style="color: var(--text-muted); max-width: 700px; margin: 16px auto 0 auto; font-size: 16px;">
        Demonstrated compliance, audit readiness, and tax structuring outcomes across industries.
      </p>
    </div>
  </section>

  <!-- Case Studies Grid Section -->
  <section class="section-padding">
    <div class="container">
      <div id="caseStudiesGrid" class="content-grid content-grid-3">
        {caseStudies.map((cs, idx) => (
          <div class="content-card card-hover reveal-on-scroll" style={`transition-delay: ${(idx % 3) * 0.1}s;`}>
            <div class="content-card-top">
              <span class="service-badge">{cs.category || cs.industry || 'Case Study'}</span>
              <span class="content-card-date">{cs.client || 'Enterprise Client'}</span>
            </div>
            <h3 class="content-card-headline" style="font-size: 18px; margin: 10px 0;">
              <a href={`/case-studies/${cs.slug || cs.id}`} style="color: inherit; text-decoration: none;">
                {cs.title}
              </a>
            </h3>
            <p class="content-card-quote" style="font-style: normal; font-size: 13.5px; line-height: 1.6; color: var(--text-muted); margin-bottom: 16px;">
              {cs.summary || cs.excerpt}
            </p>
            <div style="margin-top: auto; padding-top: 14px; border-top: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center;">
              <span style="font-size: 12px; color: var(--color-primary); font-weight: 600;">{cs.impact || 'Verified Results'}</span>
              <a href={`/case-studies/${cs.slug || cs.id}`} class="btn-link" style="color: var(--color-primary); font-weight: 700; font-size: 13px;">Read Case Study →</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
