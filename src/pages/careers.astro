---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CareerCard from '../components/CareerCard.astro';
import careersData from '../data/careers.json';

const careers = careersData.careers || [];
---

<Layout
  title="Careers & Openings | M/s NRSR & Co"
  description="Explore career opportunities, CA articleship, and professional audit/tax roles at M/s NRSR & Co Chartered Accountants."
>
  <!-- Header Banner -->
  <section class="section-padding" style="padding-top: calc(var(--header-height) + 50px); background: linear-gradient(180deg, var(--bg-alt) 0%, var(--bg-main) 100%);">
    <div class="container text-center">
      <div class="section-header text-center" style="margin-bottom:0;">
        <span class="section-subtitle">Join Our Practice</span>
        <h1 class="section-title" style="font-size: 38px;">Careers at NRSR & Co</h1>
      </div>
      <p style="color: var(--text-muted); max-width: 760px; margin: 16px auto 0 auto; font-size: 16px; line-height: 1.7;">
        Build your career with a peer-reviewed, progressive Chartered Accountancy practice. We offer high-impact exposure across taxation, audit, valuation, and corporate advisory.
      </p>
    </div>
  </section>

  <!-- Why Work With Us Pillars -->
  <section class="section-padding" style="padding-bottom: 30px;">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-subtitle">Why NRSR & Co</span>
        <h2 class="section-title">A Culture of Mentorship & Excellence</h2>
      </div>

      <div class="content-grid content-grid-3">
        <div class="content-card reveal-on-scroll">
          <div style="color:var(--color-primary); margin-bottom:12px;"><Icon name="chart" size={32} /></div>
          <h3 class="content-card-headline" style="font-size:18px;">Multi-Disciplinary Exposure</h3>
          <p class="content-card-quote" style="font-style:normal;">Gain direct hands-on training in Statutory Audits, Direct Tax litigation, GST reconciliations, MCA21 corporate filings, and Business Valuation.</p>
        </div>

        <div class="content-card reveal-on-scroll reveal-down">
          <div style="color:var(--color-primary); margin-bottom:12px;"><Icon name="graduation-cap" size={32} /></div>
          <h3 class="content-card-headline" style="font-size:18px;">Structured Articleship</h3>
          <p class="content-card-quote" style="font-style:normal;">Comprehensive ICAI articleship framework with dedicated study leaves, exam support, and rotation across specialized practice divisions.</p>
        </div>

        <div class="content-card reveal-on-scroll">
          <div style="color:var(--color-primary); margin-bottom:12px;"><Icon name="lightbulb" size={32} /></div>
          <h3 class="content-card-headline" style="font-size:18px;">Modern Tech & Automation</h3>
          <p class="content-card-quote" style="font-style:normal;">Work with cloud accounting systems, Power BI financial analytics, and paperless audit workpaper repositories.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Live Job Openings List -->
  <section class="section-padding" style="background: var(--bg-alt);">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-subtitle">Current Openings</span>
        <h2 class="section-title">Explore Open Roles</h2>
        <p style="color: var(--text-muted); max-width: 600px; margin: 10px auto 0 auto;">
          Positions are open for our Manipal headquarters and Bengaluru branch office.
        </p>
      </div>

      <div id="careersGrid" class="careers-container" style="display:flex; flex-direction:column; gap:20px; max-width:960px; margin:0 auto;">
        {careers.map(job => (
          <CareerCard job={job} />
        ))}
      </div>

      <!-- General Application Callout -->
      <div style="background:#ffffff; border:1.5px dashed var(--color-primary); border-radius:14px; padding:32px; text-align:center; max-width:960px; margin:40px auto 0 auto; box-shadow:var(--card-shadow);">
        <h3 style="font-size:20px; color:var(--text-main); margin-bottom:8px;">Don't see a matching position?</h3>
        <p style="color:var(--text-muted); font-size:14px; max-width:600px; margin:0 auto 18px auto;">
          We are always interested in meeting talented Chartered Accountants, Semi-Qualified CAs, Articled Assistants, and Accounts Executives.
        </p>
        <button class="btn btn-primary" onclick="openApplyModal('General Application')">Submit Open Resume / CV</button>
      </div>
    </div>
  </section>

  <!-- Job Application Modal Dialog -->
  <div id="careerApplyModal" class="modal-overlay">
    <div class="modal-box" style="max-width:540px;">
      <div class="modal-header">
        <h3 id="applyModalTitle" style="font-size: 19px; color: var(--color-primary);">Apply for Position</h3>
        <button id="closeApplyModalBtn" style="background:none; border:none; font-size:24px; cursor:pointer; color:var(--text-muted);" onclick="document.getElementById('careerApplyModal').classList.remove('active')">&times;</button>
      </div>
      <div id="applyModalBody" style="padding: 20px 0 0 0;">
        <form id="jobApplicationForm" onsubmit="handleJobApplicationSubmit(event)">
          <input type="hidden" id="applyJobTitle" value="">
          <div class="form-group">
            <label>Full Name *</label>
            <input type="text" id="applicantName" class="form-control" required placeholder="Your full name">
          </div>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
            <div class="form-group">
              <label>Email Address *</label>
              <input type="email" id="applicantEmail" class="form-control" required placeholder="your.email@example.com">
            </div>
            <div class="form-group">
              <label>Phone / WhatsApp *</label>
              <input type="tel" id="applicantPhone" class="form-control" required placeholder="+91 98765 43210">
            </div>
          </div>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
            <div class="form-group">
              <label>Qualification</label>
              <select id="applicantQual" class="form-control">
                <option value="CA Qualified">CA Qualified</option>
                <option value="CA Inter / Semi-Qualified">CA Inter / Semi-Qualified</option>
                <option value="IPCC Cleared (Seeking Articleship)">IPCC Cleared (Seeking Articleship)</option>
                <option value="B.Com / M.Com">B.Com / M.Com</option>
                <option value="MBA Finance">MBA Finance</option>
                <option value="Other">Other</option>
              </select>
            </div>
            <div class="form-group">
              <label>Preferred Location</label>
              <select id="applicantLocation" class="form-control">
                <option value="Manipal HQ">Manipal HQ</option>
                <option value="Bengaluru Branch">Bengaluru Branch</option>
                <option value="Either / Flexible">Either / Flexible</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label>Resume Link (Google Drive / Dropbox) or LinkedIn</label>
            <input type="text" id="applicantResumeLink" class="form-control" placeholder="Link to your Google Drive resume or LinkedIn URL">
          </div>
          <div class="form-group">
            <label>Cover Note / Relevant Experience</label>
            <textarea id="applicantNotes" class="form-control" rows="3" placeholder="Brief note on your background, articleship status, and areas of interest..."></textarea>
          </div>
          <button type="submit" id="submitAppBtn" class="btn btn-primary" style="width:100%; padding:12px; margin-top:10px; font-weight:700;">Submit Application</button>
        </form>
      </div>
    </div>
  </div>
</Layout>
