---
import settingsData from '../data/settings.json';
import Icon from './Icon.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
const settings = settingsData.settings || {};
const clientLoginUrl = settings.client_login_url || 'https://practice.turia.in/login';
const employeeLoginUrl = settings.employee_login_url || 'https://practice.turia.in/login';

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services' },
  { name: 'Meet Our Team', href: '/team' },
  { name: 'Careers', href: '/careers' },
  { name: 'Gallery', href: '/gallery' },
  { name: 'Insights & Blogs', href: '/blogs' },
  { name: 'Case Studies', href: '/case-studies' },
  { name: 'About Us', href: '/about' },
];

const isActive = (href: string) => {
  if (href === '/' && currentPath === '/') return true;
  if (href !== '/' && currentPath.startsWith(href)) return true;
  return false;
};
---

<header class="scrolled">
  <div class="container nav-wrapper">
    <a href="/" class="brand-logo">
      <img src="/assets/logo.svg" alt="NRSR & Co Logo" width="48" height="48">
      <div class="logo-text">
        <span class="logo-title">NRSR <span>& Co</span></span>
        <span class="logo-subtitle">CHARTERED ACCOUNTANTS</span>
      </div>
    </a>
    
    <nav class="nav-menu">
      {navLinks.map(link => (
        <a href={link.href} class={`nav-link ${isActive(link.href) ? 'active' : ''}`}>
          {link.name}
        </a>
      ))}

      <!-- Portal Logins Dropdown (Client Login & Employee Practice Login) -->
      <div class="nav-dropdown">
        <button class="nav-dropdown-toggle" type="button" aria-haspopup="true" aria-expanded="false" id="portalDropdownBtn">
          <Icon name="lock" size={14} color="#ffffff" />
          <span>Portal Logins</span>
          <Icon name="chevron-down" size={12} color="rgba(255,255,255,0.7)" />
        </button>
        <div class="nav-dropdown-menu">
          <a href={clientLoginUrl} target="_blank" rel="noopener noreferrer" class="nav-dropdown-item">
            <div class="dropdown-item-icon">
              <Icon name="user" size={18} color="var(--color-primary-dark)" />
            </div>
            <div class="dropdown-item-text">
              <strong>Client Login</strong>
              <small>Access files, reports & returns</small>
            </div>
          </a>
          <a href={employeeLoginUrl} target="_blank" rel="noopener noreferrer" class="nav-dropdown-item">
            <div class="dropdown-item-icon">
              <Icon name="briefcase" size={18} color="#2b6140" />
            </div>
            <div class="dropdown-item-text">
              <strong>Employee Login</strong>
              <small>Practice Portal (Turia)</small>
            </div>
          </a>
        </div>
      </div>

      <a href="/contact" class="btn btn-primary" style="padding: 8px 18px; font-size: 13px;">Contact Us</a>
    </nav>

    <div class="mobile-toggle" aria-label="Toggle Navigation Menu">
      <span></span>
      <span></span>
      <span></span>
    </div>
  </div>
</header>
