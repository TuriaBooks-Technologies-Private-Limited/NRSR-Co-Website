---
interface Props {
  name: string;
  size?: number | string;
  class?: string;
  color?: string;
  strokeWidth?: number | string;
}

const {
  name,
  size = 20,
  class: className = '',
  color = 'currentColor',
  strokeWidth = 2,
} = Astro.props;

const s = typeof size === 'number' ? `${size}px` : size;
