---
import settingsData from '../data/settings.json';
import Icon from './Icon.astro';

interface Props {
  settings?: any;
}

const settings = Astro.props.settings || settingsData.settings;
const mainPhone = settings.firm_phone || '+91 7760485737';
const cleanPhone = mainPhone.replace(/[^0-9+]/g, '');

const socials = [
  { name: 'linkedin', url: settings.linkedin_url || 'https://www.linkedin.com/company/nrsr-and-co', label: 'NRSR & Co LinkedIn', color: '#ffffff' },
  { name: 'whatsapp', url: 'https://wa.me/917760485737', label: 'NRSR & Co WhatsApp', color: '#25D366' },
  { name: 'facebook', url: settings.facebook_url, label: 'NRSR & Co Facebook', color: '#1877F2' },
  { name: 'instagram', url: settings.instagram_url, label: 'NRSR & Co Instagram', color: '#E1306C' },
  { name: 'twitter', url: settings.twitter_url, label: 'NRSR & Co Twitter / X', color: '#ffffff' },
  { name: 'youtube', url: settings.youtube_url, label: 'NRSR & Co YouTube', color: '#FF0000' }
].filter(s => !!s.url);
---

<footer>
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="brand-logo" style="margin-bottom: 16px;">
        <img src="/images/logo.png" alt="NRSR & Co Chartered Accountants" style="height: 48px; width: auto; max-width: 180px; object-fit: contain; background: #ffffff; padding: 4px 8px; border-radius: 6px;" />
      </div>
      <p>{settings.firm_name || 'M/s NRSR & Co'} is a premier partnership firm of Chartered Accountants providing financial assurance, direct & indirect taxation, registered valuation, and corporate advisory services across Karnataka.</p>
      
      <!-- Social Media Icons -->
      <div style="display: flex; gap: 10px; margin-top: 16px; flex-wrap: wrap;">
        {socials.map(soc => (
          <a
            href={soc.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={soc.label}
            style="width:36px; height:36px; border-radius:8px; background:rgba(255,255,255,0.08); display:flex; align-items:center; justify-content:center; color:#ffffff; transition:all 0.25s ease; border:1px solid rgba(255,255,255,0.12);"
            onmouseover="this.style.background='rgba(255,255,255,0.2)'; this.style.transform='translateY(-2px)';"
            onmouseout="this.style.background='rgba(255,255,255,0.08)'; this.style.transform='translateY(0)';"
          >
            <Icon name={soc.name} size={17} color={soc.name === 'whatsapp' ? '#25D366' : 'currentColor'} />
          </a>
        ))}
      </div>
    </div>

    <div class="footer-col">
      <h4>Core Verticals</h4>
      <ul class="footer-links">
        <li><a href="/services">Income Tax & GST Compliance</a></li>
        <li><a href="/services">Corporate & LLP Restructuring</a></li>
        <li><a href="/services">Statutory Audit & Assurance</a></li>
        <li><a href="/services">Registered Valuation (IBBI)</a></li>
        <li><a href="/services">Transfer Pricing & International Tax</a></li>
        <li><a href="/services">Virtual CFO & MIS Dashboards</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Quick Links</h4>
      <ul class="footer-links">
        <li><a href="/">Home</a></li>
        <li><a href="/about">About Us</a></li>
        <li><a href="/services">Our Services</a></li>
        <li><a href="/case-studies">Enterprise Case Studies</a></li>
        <li><a href="/blogs">Insights & Blogs</a></li>
        <li><a href="/team">Meet Our Team</a></li>
        <li><a href="/careers">Careers & Openings</a></li>
        <li><a href="/gallery">Occasions & Photo Gallery</a></li>
        <li><a href="/contact">Contact Us</a></li>
        <li style="margin-top: 8px; padding-top: 8px; border-top: 1px solid rgba(255,255,255,0.1);">
          <a href={settings.client_login_url || 'https://practice.turia.in/login'} target="_blank" rel="noopener noreferrer" style="color: var(--color-primary-light); font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
            <Icon name="user" size={14} color="var(--color-primary-light)" />
            <span>Client Login</span>
          </a>
        </li>
        <li>
          <a href={settings.employee_login_url || 'https://practice.turia.in/login'} target="_blank" rel="noopener noreferrer" style="color: var(--color-accent); font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
            <Icon name="briefcase" size={14} color="var(--color-accent)" />
            <span>Employee Login</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Contact Info</h4>
      <ul class="footer-links" style="font-size: 13.5px; color: rgba(255,255,255,0.7);">
        <li style="margin-bottom: 12px; display: flex; align-items: flex-start; gap: 8px;">
          <span style="margin-top: 2px; flex-shrink: 0;"><Icon name="map-pin" size={16} color="var(--color-primary-light)" /></span>
          <span>{settings.hq_address}</span>
        </li>
        <li style="margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
          <span style="flex-shrink: 0;"><Icon name="phone" size={15} color="var(--color-primary-light)" /></span>
          <a href={`tel:${cleanPhone}`}>{mainPhone}</a>
        </li>
        <li style="margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
          <span style="flex-shrink: 0;"><Icon name="mail" size={15} color="var(--color-primary-light)" /></span>
          <a href={`mailto:${settings.firm_email}`}>{settings.firm_email}</a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Mandatory Footer Disclaimer Accordion -->
  <div class="footer-disclaimer" id="footerDisclaimerWrapper">
    <button class="footer-disclaimer-toggle" id="footerDisclaimerToggle" type="button" aria-expanded="false">
      <span>ICAI Regulatory Disclaimer</span>
      <span class="footer-disclaimer-caret"><Icon name="chevron-down" size={14} /></span>
    </button>
    <div class="footer-disclaimer-text" id="footerDisclaimerText">
      As per the rules and regulations prescribed by the Institute of Chartered Accountants of India (ICAI), Chartered Accountants in India are prohibited from soliciting client work or advertising services in any form. This website is hosted solely for informational purposes to provide general background information about the practice profile, verticals, and credentials of M/s NRSR & Co. The information contained herein does not constitute professional advice, solicitation, invitation, or commercial advertisement under the Chartered Accountants Act, 1949.
    </div>
  </div>

  <div class="container footer-bottom">
    <div>© 2026 M/s NRSR & Co. All rights reserved.</div>
    <div style="display: flex; align-items: center; gap: 10px;">
      <span>Built & Powered by <a href="https://turia.in" target="_blank" rel="noopener noreferrer" style="color:var(--color-primary-light); font-weight:700; text-decoration:underline;">Turia.in</a></span>
      <span>•</span>
      <a href="/admin" style="color:rgba(255,255,255,0.45); font-size:12px; display: inline-flex; align-items: center; gap: 4px;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.7'">
        <Icon name="settings" size={12} color="currentColor" />
        <span>Admin Access</span>
      </a>
    </div>
  </div>
</footer>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('footerDisclaimerToggle');
    const wrapper = document.getElementById('footerDisclaimerWrapper');
    if (btn && wrapper) {
      btn.addEventListener('click', () => {
        const isExpanded = wrapper.classList.toggle('expanded');
        btn.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
      });
    }
  });
</script>
