---
interface Props {
  member: {
    id: string;
    name: string;
    role: string;
    category?: string;
    qualification?: string;
    expertise?: string;
    bio?: string;
    image?: string;
  };
  index?: number;
}

const { member, index = 0 } = Astro.props;
---

<div class="member-card tilt-card card-hover reveal-on-scroll" style={`transition-delay: ${(index % 3) * 0.1}s;`}>
  {member.image ? (
    <div class="member-avatar" style="background:none; border:3px solid var(--color-primary); box-shadow: 0 8px 20px -6px var(--glow-cyan); overflow:hidden;">
      <img src={member.image} alt={member.name} style="width:100%; height:100%; object-fit:cover;" loading="lazy" />
    </div>
  ) : (
    <div class="member-avatar">
      {member.name.charAt(0)}
    </div>
  )}
  <h3>{member.name}</h3>
  <div class="member-role">{member.role}</div>
  {member.qualification && <div class="member-qual" style="color:var(--color-primary); font-weight:600; font-size:12px; margin-top:4px;">{member.qualification}</div>}
  {member.expertise && (
    <div class="member-expertise" style="margin-top:10px;">
      <strong style="color:var(--text-main);">Expertise:</strong> {member.expertise}
    </div>
  )}
  {member.bio && <div class="member-bio" style="font-size:13px; color:var(--text-muted); margin-top:8px;">{member.bio}</div>}
</div>
