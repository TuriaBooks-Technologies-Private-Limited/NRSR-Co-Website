---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DisclaimerGate from '../components/DisclaimerGate.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  type?: string;
  jsonLd?: Record<string, any>;
}

const {
  title = "M/s NRSR & Co | Chartered Accountants & Advisors",
  description = "M/s NRSR & Co is a partnership firm of Chartered Accountants providing audit, direct tax litigation, GST compliance, business valuation, and corporate advisory services.",
  keywords = "NRSR & Co, Chartered Accountants, Manipal CA, Tax Litigation, Business Valuation, Statutory Audit, GST Filings, Corporate Advisory",
  image = "https://nrsrcoconsultants.com/assets/logo.svg",
  type = "website",
  jsonLd = {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "M/s NRSR & Co",
    "url": "https://nrsrcoconsultants.com",
    "logo": "https://nrsrcoconsultants.com/assets/logo.svg",
    "telephone": "+919108599083",
    "email": "info@nrsrandco.com",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "'Gokula', 1st Floor, Union Bank Building, Opp. Green Park Hotel, Near Tiger Circle",
      "addressLocality": "Manipal",
      "addressRegion": "Karnataka",
      "postalCode": "576104",
      "addressCountry": "IN"
    },
    "openingHours": "Mo-Sa 09:30-18:30"
  }
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://nrsrcoconsultants.com');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <meta name="keywords" content={keywords}>
  <meta name="author" content="M/s NRSR & Co">
  <link rel="canonical" href={canonicalURL}>
  
  <!-- OpenGraph SEO Tags -->
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content={type}>
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:image" content={image}>

  <!-- Twitter Card Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={image}>

  <title>{title}</title>
  
  <link rel="icon" type="image/svg+xml" href="/assets/logo.svg">
  
  <!-- Structured Data JSON-LD (Schema.org) -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Core Client Scripts -->
  <script defer src="/js/store.js"></script>
  <script defer src="/js/main.js"></script>
  <script defer src="/js/animations.js"></script>
</head>
<body>

  <!-- ICAI Mandatory Disclaimer Gate -->
  <DisclaimerGate />

  <!-- Navigation Header -->
  <Header currentPath={Astro.url.pathname} />

  <!-- Main Body Slot -->
  <main>
    <slot />
  </main>

  <!-- Floating WhatsApp Quick Action Button -->
  <a href="https://wa.me/919108599083?text=Hello%20NRSR%20%26%20Co,%20I%20would%20like%20to%20inquire%20about%20your%20services." target="_blank" rel="noopener noreferrer" class="floating-whatsapp" aria-label="Chat on WhatsApp">
    <svg viewBox="0 0 32 32">
      <path d="M16 2a14 14 0 0 0-12 21.2L2 30l6.9-1.8A14 14 0 1 0 16 2zm0 25.6a11.5 11.5 0 0 1-5.9-1.6l-.4-.2-4.4 1.1 1.2-4.3-.3-.4A11.6 11.6 0 1 1 16 27.6zm6.3-8.7c-.3-.2-2-.9-2.3-1s-.6-.2-.8.2-.9 1.1-1.1 1.3-.4.3-.7.1a9.2 9.2 0 0 1-2.7-1.7 10.2 10.2 0 0 1-1.9-2.3c-.2-.3 0-.5.1-.7s.3-.4.5-.6l.3-.4c.1-.2.1-.4 0-.6s-.8-1.9-1.1-2.6c-.3-.7-.6-.6-.8-.6h-.7c-.2 0-.7.1-1 .5a4.4 4.4 0 0 0-1.4 3.3c0 1.9 1.4 3.8 1.6 4.1s2.8 4.3 6.8 6c1 .4 1.7.7 2.3.9 1 .3 1.9.3 2.6.2.8-.1 2.4-1 2.8-1.9s.3-1.7.2-1.9c-.1-.1-.4-.2-.7-.3z"/>
    </svg>
  </a>

  <!-- Footer -->
  <Footer />

  <!-- Tawk.to Live Chat -->
  <script type="text/javascript" is:inline>
    var Tawk_API=Tawk_API||{}, Tawk_LoadStart=new Date();
    (function(){
      var s1=document.createElement("script"),s0=document.getElementsByTagName("script")[0];
      s1.async=true;
      s1.src="https://embed.tawk.to/6011a916c31c9117cb73225c/default";
      s1.charset="UTF-8";
      s1.setAttribute("crossorigin","*");
      s0.parentNode.insertBefore(s1,s0);
    })();
  </script>
</body>
</html>
